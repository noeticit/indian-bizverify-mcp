# ── Official free APIs ────────────────────────────────────
# MCA21 Master Data Service (free registration at mca.gov.in)
MCA_API_KEY=

# data.gov.in (free registration at data.gov.in/user/register)
DATA_GOV_API_KEY=

# ── Optional premium KYC APIs (plug in any one to upgrade) ─
KARZA_API_KEY=
SIGNZY_API_KEY=
IDFY_API_KEY=

# ── Cache ─────────────────────────────────────────────────
CACHE_TABLE_NAME=bizverify-cache
DISABLE_DYNAMO_CACHE=false         # set true for local dev

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info                     # debug | info | warn | error
SCRAPER_TIMEOUT_MS=15000
RATE_LIMIT_PER_MIN=60
REGION=ap-south-1
